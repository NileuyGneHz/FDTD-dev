# 从带结构的“RCP.fsp”中提取电场数据：

load("RCP.fsp");
data = getresult("field","E");
E = data.E;
x = data.x;
z = data.z;

nx = length(x);
nz = length(z);

Ex = matrix(nx, nz);
Ey = matrix(nx, nz);
Ez = matrix(nx, nz);

Ex(:,:) = E(:,1,:,1,1);
Ey(:,:) = E(:,1,:,1,2);
Ez(:,:) = E(:,1,:,1,3);

# 从不带结构的“RCP-bk.fsp”中提取电场数据：

load("RCP-bk.fsp");
data = getresult("field","E");
E = data.E;

Ebkx = matrix(nx, nz);
Ebky = matrix(nx, nz);
Ebkz = matrix(nx, nz);

Ebkx(:,:) = E(:,1,:,1,1);
Ebky(:,:) = E(:,1,:,1,2);
Ebkz(:,:) = E(:,1,:,1,3);

# 将带结构的电场-不带结构的电场=散射电场（相对电场）

Erelx = Ex - Ebkx;
Erely = Ey - Ebky;
Erelz = Ez - Ebkz;

normErel = sqrt(abs(Erelx)^2+abs(Erely)^2+abs(Erelz)^2); #散射（相对）电场模

image(x*1e6,z*1e6,normErel,"x/um","z/um","RCP |E|");

# 相位分布：

phaserel = angle(Erelx);
image(x*1e6,z*1e6,phaserel,"x/um","z/um","RCP phase");






